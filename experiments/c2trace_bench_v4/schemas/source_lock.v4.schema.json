{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c2trace.local/schemas/c2trace.bench.source_lock.v4",
  "title": "C2Trace Bench v4 pinned public source",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "source_kind",
    "dataset_stratum",
    "repository",
    "revision",
    "license",
    "retrieved_on",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "c2trace.bench.source_lock.v4"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"
    },
    "source_kind": {
      "enum": [
        "attack_flow",
        "attack_evaluations",
        "ctid_micro",
        "caldera_native"
      ]
    },
    "dataset_stratum": {
      "enum": [
        "named_chain_projection",
        "micro_emulation_plan",
        "platform_native_control"
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"
    },
    "revision": {
      "type": "object",
      "required": [
        "commit"
      ],
      "properties": {
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "commit_date": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "required": [
        "spdx",
        "path",
        "sha256"
      ],
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "retrieved_on": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "path",
          "sha256"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,160}$"
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    }
  },
  "additionalProperties": false
}
