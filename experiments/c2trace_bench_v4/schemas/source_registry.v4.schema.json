{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c2trace.local/schemas/c2trace.bench.source_registry.v4",
  "title": "C2Trace Bench v4 source registry",
  "type": "object",
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "c2trace.bench.source_registry.v4"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_kind",
          "dataset_stratum",
          "lock_path",
          "lock_sha256"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"
          },
          "source_kind": {
            "enum": [
              "attack_flow",
              "attack_evaluations",
              "ctid_micro",
              "caldera_native"
            ]
          },
          "dataset_stratum": {
            "enum": [
              "named_chain_projection",
              "micro_emulation_plan",
              "platform_native_control"
            ]
          },
          "lock_path": {
            "type": "string",
            "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          },
          "lock_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
