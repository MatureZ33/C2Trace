{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c2trace.local/schemas/c2trace.bench.evidence_plan.v4",
  "title": "C2Trace Bench v4 pre-registered evidence capture plan",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "source_id",
    "dataset_stratum",
    "captures"
  ],
  "properties": {
    "schema_version": {
      "const": "c2trace.bench.evidence_plan.v4"
    },
    "case_id": {
      "type": "string",
      "pattern": "^(AF|AEL|MEP|STK)-[A-Z0-9][A-Z0-9-]*$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_stratum": {
      "enum": [
        "named_chain_projection",
        "micro_emulation_plan",
        "platform_native_control"
      ]
    },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capture_id",
          "stage",
          "collector",
          "trace_fact_ids",
          "required"
        ],
        "properties": {
          "capture_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
          },
          "stage": {
            "enum": [
              "baseline",
              "post_bootstrap",
              "before_response",
              "after_dryrun",
              "after_execute"
            ]
          },
          "collector": {
            "enum": [
              "host_snapshot",
              "suricata",
              "caldera_report",
              "powershell_history",
              "dns_cache",
              "custom_read_only"
            ]
          },
          "trace_fact_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "selector": {
            "type": "object"
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
